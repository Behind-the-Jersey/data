{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beyond-The-Jersey/data/schema/dropped.schema.json",
  "title": "Dropped deal",
  "description": "One dropped record: data/dropped/<id>.json",
  "type": "object",
  "required": [
    "id",
    "year",
    "clubId",
    "sponsorId",
    "what",
    "text",
    "source",
    "featured"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "year": {
      "type": "integer"
    },
    "clubId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "orgName": {
      "type": "string"
    },
    "sponsorId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "what": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "name",
        "date",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "short": {
          "type": "string",
          "description": "Short label for small source lines, e.g. 'SportsPro' next to a deal value."
        },
        "quote": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400,
          "description": "Words copied exactly from the page that support the fact (at most about 30 words). CI looks for them on the page."
        },
        "checked": {
          "type": "object",
          "required": [
            "on",
            "by"
          ],
          "additionalProperties": false,
          "description": "Who opened the page and confirmed that the quote supports the fact, and when.",
          "properties": {
            "on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "by": {
              "type": "string",
              "minLength": 1,
              "description": "A GitHub login, or the name of the audit that checked it."
            }
          }
        }
      }
    },
    "featured": {
      "type": "boolean"
    },
    "todo": {
      "type": "string"
    },
    "leagueId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional. For items about an organisation rather than a club (orgName), the league or competition it belongs to, so it can be shown under the right sport."
    }
  }
}
