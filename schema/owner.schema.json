{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Behind-the-Jersey/data/schema/owner.schema.json",
  "title": "Owner",
  "description": "Who ultimately owns a sponsor. parentId points up the chain (e.g. fund -> state).",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "parentId"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "enum": [
        "state",
        "state-fund",
        "listed-company",
        "private-company",
        "unknown"
      ]
    },
    "country": {
      "type": "string"
    },
    "via": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
