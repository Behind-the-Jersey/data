{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Behind-the-Jersey/data/schema/deal.schema.json",
  "title": "Deals (money)",
  "description": "Reported values are press estimates.",
  "type": "object",
  "required": [
    "id",
    "clubId",
    "orgName",
    "sponsorId",
    "placement",
    "from",
    "to",
    "value",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "clubId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "orgName": {
      "type": [
        "string",
        "null"
      ]
    },
    "sponsorId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "placement": {
      "enum": [
        "front",
        "back",
        "sleeve",
        "patch",
        "shorts",
        "stadium",
        "partner",
        "league-partner",
        "training-kit"
      ]
    },
    "from": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(-[0-9]{2})?$"
    },
    "to": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(-[0-9]{2})?$"
    },
    "value": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "amount",
        "currency",
        "unit",
        "per",
        "upTo",
        "usdApprox"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "enum": [
            "GBP",
            "EUR",
            "USD"
          ]
        },
        "unit": {
          "type": "string"
        },
        "per": {
          "type": "string"
        },
        "upTo": {
          "type": "boolean"
        },
        "usdApprox": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "name",
        "date",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "short": {
          "type": "string",
          "description": "Short label for small source lines, e.g. 'SportsPro' next to a deal value."
        },
        "quote": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400,
          "description": "Words copied exactly from the page that support the fact (at most about 30 words). CI looks for them on the page."
        },
        "checked": {
          "type": "object",
          "required": [
            "on",
            "by"
          ],
          "additionalProperties": false,
          "description": "Who opened the page and confirmed that the quote supports the fact, and when.",
          "properties": {
            "on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "by": {
              "type": "string",
              "minLength": 1,
              "description": "A GitHub login, or the name of the audit that checked it."
            }
          }
        }
      }
    },
    "note": {
      "type": "string"
    },
    "leagueId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional. For items about an organisation rather than a club (orgName), the league or competition it belongs to, so it can be shown under the right sport."
    },
    "endedOn": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "description": "YYYY-MM when the deal ended at a known month. Drives 'Gone since June 2026'."
    }
  }
}
