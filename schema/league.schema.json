{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beyond-The-Jersey/data/schema/league.schema.json",
  "title": "Leagues and competition",
  "description": "One league record: data/leagues/<id>.json",
  "type": "object",
  "required": [
    "id",
    "aliases",
    "sportId",
    "name",
    "status",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sportId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "clubCount": {
      "type": "integer"
    },
    "season": {
      "type": "string"
    },
    "status": {
      "enum": [
        "partial",
        "complete",
        "not-started"
      ]
    },
    "frontOfShirtTotal": {
      "type": "object",
      "required": [
        "amount",
        "currency",
        "unit",
        "per",
        "usdApprox",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "per": {
          "type": "string"
        },
        "usdApprox": {
          "type": "number"
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "name",
            "date",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": "string"
            },
            "short": {
              "type": "string",
              "description": "Short label for small source lines, e.g. 'SportsPro' next to a deal value."
            },
            "quote": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400,
              "description": "Words copied exactly from the page that support the fact (at most about 30 words). CI looks for them on the page."
            },
            "checked": {
              "type": "object",
              "required": [
                "on",
                "by"
              ],
              "additionalProperties": false,
              "description": "Who opened the page and confirmed that the quote supports the fact, and when.",
              "properties": {
                "on": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "by": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A GitHub login, or the name of the audit that checked it."
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
