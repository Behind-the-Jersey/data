{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Behind-the-Jersey/data/schema/sponsor.schema.json",
  "title": "Sponsor",
  "description": "One sponsor record: data/sponsors/<id>.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "ownerId",
    "ownership",
    "tier",
    "status",
    "verdict",
    "claimIds",
    "aliases"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "ownerId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ownership": {
      "enum": [
        "owned",
        "part-owned",
        null
      ]
    },
    "tier": {
      "enum": [
        "unrated",
        "none",
        "concern",
        "serious",
        "severe"
      ]
    },
    "status": {
      "enum": [
        "rated",
        "unrated",
        "being-rated"
      ]
    },
    "verdict": {
      "type": [
        "string",
        "null"
      ]
    },
    "claimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "ownerVerb": {
      "enum": [
        "owned by",
        "paid for by"
      ],
      "description": "For sentences about the owner. Defaults to 'owned by'."
    },
    "why": {
      "type": "object",
      "description": "The team page's 'Why is that a problem?' text and the sentence for the 'Tell {club}' message. Written only from the listed claims, which must share an owner with the sponsor's owner chain.",
      "required": [
        "text",
        "claimIds",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "claimIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "messageLine": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "reviewed"
          ]
        }
      }
    }
  }
}
