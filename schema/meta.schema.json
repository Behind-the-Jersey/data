{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date of the latest data change. Shown on the landing page as 'UPDATED 24 SEP 2026'."
    },
    "generatedBy": {
      "type": "string"
    },
    "sourceCommit": {
      "type": "string"
    }
  },
  "$id": "https://github.com/Behind-the-Jersey/data/schema/meta.schema.json"
}
