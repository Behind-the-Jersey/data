{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Behind-the-Jersey/data/schema/contact.schema.json",
  "title": "Club contact channel",
  "description": "Public channels a fan can use to tell a club what they think of a sponsor. Every channel needs the URL of the page where the club publishes it. No placeholders and no guessed addresses: leave a channel out if it can't be sourced.",
  "type": "object",
  "required": [
    "clubId",
    "channels",
    "lastChecked"
  ],
  "additionalProperties": false,
  "properties": {
    "clubId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "email",
              "contact-form",
              "x",
              "instagram",
              "facebook",
              "phone",
              "website"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 3,
            "not": {
              "pattern": "(X{3,}|\\.\\.\\.|example\\.)"
            },
            "description": "Email address, full URL for contact-form/website, handle with @ for x/instagram, page name or URL for facebook, phone in international format."
          },
          "label": {
            "type": "string",
            "description": "Who it reaches, e.g. 'Supporter services'"
          },
          "source": {
            "type": "object",
            "required": [
              "name",
              "url",
              "date"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "date": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 10,
                "maxLength": 400,
                "description": "Words copied exactly from the page that support the fact (at most about 30 words). CI looks for them on the page."
              },
              "checked": {
                "type": "object",
                "required": [
                  "on",
                  "by"
                ],
                "additionalProperties": false,
                "description": "Who opened the page and confirmed that the quote supports the fact, and when.",
                "properties": {
                  "on": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A GitHub login, or the name of the audit that checked it."
                  }
                }
              }
            }
          }
        }
      }
    },
    "lastChecked": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
