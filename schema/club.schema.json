{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Behind-the-Jersey/data/schema/club.schema.json",
  "title": "Clubs and team",
  "description": "One club record: data/clubs/<id>.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "shortName",
    "code",
    "sportId",
    "leagueId",
    "country",
    "crest",
    "aliases"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "shortName": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "sportId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "leagueId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "crest": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hasTeamPageDesign": {
      "type": "boolean",
      "description": "Deprecated, optional. The site decides whether a team page exists from the current kit (front and back photos plus hotspots)."
    },
    "contact": {
      "description": "Where 'Tell {club}' sends people: a checked address with its source. Leave null until someone has checked it. Never guess one.",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "source"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "email"
              ]
            },
            {
              "required": [
                "url"
              ]
            }
          ],
          "properties": {
            "kind": {
              "enum": [
                "supporter-liaison",
                "contact-page"
              ]
            },
            "email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "source": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
