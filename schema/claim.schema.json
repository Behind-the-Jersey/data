{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beyond-The-Jersey/data/schema/claim.schema.json",
  "title": "Claims (evidence)",
  "description": "One sourced statement about an owner. It's published once every source on it is checked (a quote from the page, and who checked it); a rating needs two independent sources for each claim it rests on (METHOD.md). reviewed=true once a person has checked it.",
  "type": "object",
  "required": [
    "id",
    "ownerIds",
    "text",
    "source",
    "reviewed"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "ownerIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "text": {
      "type": "string"
    },
    "short": {
      "type": "string"
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "name",
        "date",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "short": {
          "type": "string",
          "description": "Short label for small source lines, e.g. 'SportsPro' next to a deal value."
        },
        "quote": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400,
          "description": "Words copied exactly from the page that support the fact (at most about 30 words). CI looks for them on the page."
        },
        "checked": {
          "type": "object",
          "required": [
            "on",
            "by"
          ],
          "additionalProperties": false,
          "description": "Who opened the page and confirmed that the quote supports the fact, and when.",
          "properties": {
            "on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "by": {
              "type": "string",
              "minLength": 1,
              "description": "A GitHub login, or the name of the audit that checked it."
            }
          }
        }
      }
    },
    "reviewed": {
      "type": "boolean"
    },
    "additionalSources": {
      "type": "array",
      "description": "More sources for the same statement, each from a different publisher. A claim a Concern, Serious or Severe rating rests on needs at least one (METHOD.md).",
      "items": {
        "type": "object",
        "required": [
          "name",
          "date",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "short": {
            "type": "string",
            "description": "Short label for small source lines, e.g. 'SportsPro' next to a deal value."
          },
          "quote": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400,
            "description": "Words copied exactly from the page that support the fact (at most about 30 words). CI looks for them on the page."
          },
          "checked": {
            "type": "object",
            "required": [
              "on",
              "by"
            ],
            "additionalProperties": false,
            "description": "Who opened the page and confirmed that the quote supports the fact, and when.",
            "properties": {
              "on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "by": {
                "type": "string",
                "minLength": 1,
                "description": "A GitHub login, or the name of the audit that checked it."
              }
            }
          }
        }
      }
    }
  }
}
