{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sponsor tiers",
  "description": "Per-sponsor severity.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "score",
      "label",
      "color",
      "description"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "enum": [
          "unrated",
          "none",
          "concern",
          "serious",
          "severe"
        ]
      },
      "score": {
        "type": [
          "integer",
          "null"
        ]
      },
      "label": {
        "type": "string"
      },
      "color": {
        "type": "string"
      },
      "fill": {
        "type": "string"
      },
      "description": {
        "type": "string"
      }
    }
  },
  "$id": "https://github.com/Behind-the-Jersey/data/schema/tiers.schema.json"
}
