{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Behind-the-Jersey/data/schema/kit.schema.json",
  "title": "Kits (one per club per season or period)",
  "description": "hotspot: logo centre (x,y) and size (w,h) as fractions of the photo (photos are 720x800); side: which photo the logo is on. cardSlot is no longer used (v3 team page) but still accepted. headline: the sentence under the club name, with {level} for the level word. shortLine: one line for 'Travel back in time'.",
  "type": "object",
  "required": [
    "id",
    "clubId",
    "season",
    "kitType",
    "periodLabel",
    "periodFrom",
    "periodTo",
    "photos",
    "sponsors",
    "sponsorsComplete",
    "summary",
    "change"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "clubId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "season": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(-[0-9]{2})?$"
    },
    "kitType": {
      "enum": [
        "home",
        "away",
        "third"
      ]
    },
    "periodLabel": {
      "type": "string"
    },
    "periodFrom": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(-[0-9]{2})?$"
    },
    "periodTo": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(-[0-9]{2})?$"
    },
    "photos": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "front": {
          "type": "string"
        },
        "back": {
          "type": "string"
        },
        "square": {
          "type": "string"
        }
      }
    },
    "sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sponsorId",
          "placement"
        ],
        "additionalProperties": false,
        "properties": {
          "sponsorId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "placement": {
            "enum": [
              "front",
              "back",
              "sleeve",
              "patch",
              "shorts",
              "stadium",
              "partner",
              "league-partner",
              "training-kit"
            ]
          },
          "side": {
            "enum": [
              "front",
              "back"
            ]
          },
          "hotspot": {
            "type": "object",
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          },
          "cardSlot": {
            "enum": [
              "L",
              "R",
              "T"
            ]
          },
          "source": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "name",
              "date",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              },
              "short": {
                "type": "string",
                "description": "Short label for small source lines, e.g. 'SportsPro' next to a deal value."
              },
              "quote": {
                "type": "string",
                "minLength": 10,
                "maxLength": 400,
                "description": "Words copied exactly from the page that support the fact (at most about 30 words). CI looks for them on the page."
              },
              "checked": {
                "type": "object",
                "required": [
                  "on",
                  "by"
                ],
                "additionalProperties": false,
                "description": "Who opened the page and confirmed that the quote supports the fact, and when.",
                "properties": {
                  "on": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A GitHub login, or the name of the audit that checked it."
                  }
                }
              }
            },
            "description": "Where this sponsor and placement on this season's shirt is documented (club announcement, kit launch, press)."
          }
        }
      }
    },
    "sponsorsComplete": {
      "type": "boolean"
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "change": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "badge"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "worse",
                "better"
              ]
            },
            "text": {
              "type": "string",
              "description": "Change badge on the team page, e.g. 'Worse than last season: Visit Rwanda took the front'"
            },
            "badge": {
              "type": "string",
              "description": "Short timeline note, e.g. '+ Visit Rwanda' or 'Rwanda gone'"
            }
          }
        }
      ]
    },
    "levelOverride": {
      "enum": [
        "not-rated",
        "clean",
        "spotted",
        "stained",
        "soaked"
      ]
    },
    "headline": {
      "type": "string",
      "description": "The sentence under the club name on the team page. '{level}' is replaced by the level word; past kits use 'was'."
    },
    "shortLine": {
      "type": "string",
      "description": "One line for 'Travel back in time', e.g. 'Emirates on the front'."
    }
  }
}
