{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beyond-The-Jersey/data/schema/change.schema.json",
  "title": "Recent changes feed",
  "description": "One change record: data/changes/<id>.json",
  "type": "object",
  "required": [
    "id",
    "date",
    "datePrecision",
    "clubId",
    "sponsorId",
    "kind",
    "levelAfter",
    "title",
    "text",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "datePrecision": {
      "enum": [
        "day",
        "month",
        "year"
      ]
    },
    "clubId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "sponsorId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "worse",
        "better",
        "renewed",
        "being-rated",
        "new"
      ]
    },
    "levelAfter": {
      "enum": [
        "not-rated",
        "clean",
        "spotted",
        "stained",
        "soaked"
      ]
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "name",
        "date",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "short": {
          "type": "string",
          "description": "Short label for small source lines, e.g. 'SportsPro' next to a deal value."
        },
        "quote": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400,
          "description": "Words copied exactly from the page that support the fact (at most about 30 words). CI looks for them on the page."
        },
        "checked": {
          "type": "object",
          "required": [
            "on",
            "by"
          ],
          "additionalProperties": false,
          "description": "Who opened the page and confirmed that the quote supports the fact, and when.",
          "properties": {
            "on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "by": {
              "type": "string",
              "minLength": 1,
              "description": "A GitHub login, or the name of the audit that checked it."
            }
          }
        }
      }
    }
  }
}
